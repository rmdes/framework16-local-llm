[Unit]
Description=llama.cpp server (@BACKEND@ / RX 7700S gfx1102) — on demand behind llama-proxy.socket (:@PORT@)
Documentation=https://github.com/ggml-org/llama.cpp
# Started by llama-proxy.service on the first connection to :@PORT@, stopped once the proxy idles out.
# Always-on it sat idle 23h/day holding ~8G of RAM+swap (2026-10).
StopWhenUnneeded=yes
# Stop a crash-loop from hammering the GPU forever: give up after 5 failures in 120s.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
# llama-go handles discrete-GPU pinning (gfx1102) internally and then launches the server.
ExecStart=@LLAMAGO@ -b @BACKEND@ -m @MODEL@ -c @CTX@ --port @BACKPORT@
# "started" = model loaded, so the proxy never forwards into a half-loaded server (/health is 503 while loading).
ExecStartPost=/bin/sh -c 'until curl -sf -o /dev/null http://127.0.0.1:@BACKPORT@/health; do sleep 0.5; done'
TimeoutStartSec=300
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
